  change (BitVec.ofNat 65536 expNat).getLsbD r.val = decide (8 ≤ (List.ofFn (fun i : Fin 16 => r.val.testBit i.val)).count true)
  rw [BitVec.getLsbD_ofNat, rowList, ← e]
  simp [r.isLt]

